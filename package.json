{
  "name": "rebake",
  "version": "0.1.0",
  "description": "A Bun framework for building command-line applications.",
  "keywords": [
    "bun",
    "cli",
    "cli-framework",
    "command-line",
    "decorators",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/rebake.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./prompts": "./src/prompts/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "format": "prettier \"**/*.{json,md,ts,yaml,yml}\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{json,md,ts,yaml,yml}\" --check --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-sort": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  }
}
